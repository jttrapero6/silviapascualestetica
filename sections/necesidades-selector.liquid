{%- comment -%}
  Selector de necesidades: lista editorial de títulos grandes + escenario visual.
  · Escritorio: al pasar el ratón por un título cambia la imagen/vídeo del escenario (fijo a la derecha);
    al hacer clic se despliega su texto bajo el título.
  · Móvil: acordeón; la necesidad abierta muestra su imagen/vídeo y el texto.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<section class="nec color-scheme color-scheme--{{ section.settings.color_scheme.id }}" data-nec>
  <div class="container">
    <div class="nec__layout">
      <div class="nec__main">
        <header class="nec__header">
          {%- if section.settings.eyebrow != blank -%}
            <p class="nec__eyebrow">{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          {%- if section.settings.title != blank -%}
            <h2 class="nec__title">{{ section.settings.title }}</h2>
          {%- endif -%}
          {%- if section.settings.subtitle != blank -%}
            <div class="nec__subtitle">{{ section.settings.subtitle }}</div>
          {%- endif -%}
        </header>

        <ol class="nec__list" role="list">
          {%- for block in section.blocks -%}
            {%- assign number = forloop.index | prepend: '0' | slice: -2, 2 -%}

            <li
              class="nec__item{% if forloop.first %} is-active{% endif %}"
              data-nec-item
              {{ block.shopify_attributes }}
            >
              <h3 class="nec__item-heading">
                <button
                  class="nec__trigger"
                  type="button"
                  id="NecTrigger-{{ block.id }}"
                  aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
                  aria-controls="NecBody-{{ block.id }}"
                  data-nec-trigger
                >
                  <span class="nec__number">{{ number }}</span>
                  <span class="nec__label">{{ block.settings.title }}</span>
                  <span class="nec__icon" aria-hidden="true"></span>
                </button>
              </h3>

              <div class="nec__body" id="NecBody-{{ block.id }}" role="region" aria-labelledby="NecTrigger-{{ block.id }}">
                <div class="nec__body-inner">
                  <div class="nec__inline-media">
                    {%- render 'necesidades-media', block: block, sizes: '100vw' -%}
                  </div>

                  {%- if block.settings.question != blank -%}
                    <p class="nec__question">{{ block.settings.question }}</p>
                  {%- endif -%}

                  {%- if block.settings.content != blank -%}
                    <div class="nec__text prose">{{ block.settings.content }}</div>
                  {%- endif -%}

                  {%- if block.settings.detail_1_title != blank or block.settings.detail_2_title != blank or block.settings.detail_3_title != blank -%}
                    <dl class="nec__details">
                      {%- for i in (1..3) -%}
                        {%- assign d_title_key = 'detail_' | append: i | append: '_title' -%}
                        {%- assign d_text_key = 'detail_' | append: i | append: '_text' -%}
                        {%- if block.settings[d_title_key] != blank -%}
                          <div class="nec__detail">
                            <dt>{{ block.settings[d_title_key] }}</dt>
                            {%- if block.settings[d_text_key] != blank -%}
                              <dd>{{ block.settings[d_text_key] }}</dd>
                            {%- endif -%}
                          </div>
                        {%- endif -%}
                      {%- endfor -%}
                    </dl>
                  {%- endif -%}

                  {%- if block.settings.highlight != blank -%}
                    <p class="nec__highlight">{{ block.settings.highlight }}</p>
                  {%- endif -%}

                  {%- if block.settings.button_text != blank and block.settings.button_link != blank -%}
                    <a class="nec__link" href="{{ block.settings.button_link }}">
                      {{- block.settings.button_text -}}
                      <span aria-hidden="true">→</span>
                    </a>
                  {%- endif -%}
                </div>
              </div>
            </li>
          {%- endfor -%}
        </ol>
      </div>

      <div class="nec__stage" aria-hidden="true">
        <div class="nec__stage-frame">
          {%- for block in section.blocks -%}
            <figure class="nec__slide{% if forloop.first %} is-shown{% endif %}" data-nec-slide>
              {%- render 'necesidades-media', block: block, sizes: '(max-width: 999px) 100vw, 55vw' -%}
              <figcaption class="nec__caption">
                <span class="nec__caption-number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                <span class="nec__caption-text">
                  <span class="nec__caption-title">{{ block.settings.title }}</span>
                </span>
              </figcaption>
            </figure>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var desktop = window.matchMedia('(min-width: 1000px)');
    var finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');

    function initNec(root) {
      (root || document).querySelectorAll('[data-nec]').forEach(function (section) {
        if (section.dataset.necReady === 'true') return;
        section.dataset.necReady = 'true';

        var items = Array.from(section.querySelectorAll('[data-nec-item]'));
        var triggers = items.map(function (item) { return item.querySelector('[data-nec-trigger]'); });
        var slides = Array.from(section.querySelectorAll('[data-nec-slide]'));
        var active = 0;
        var shown = 0;
        var inView = false;
        var hoverTimer = null;

        function syncVideos() {
          section.querySelectorAll('video').forEach(function (video) {
            var slide = video.closest('[data-nec-slide]');
            var item = video.closest('[data-nec-item]');
            var visible = video.offsetParent !== null &&
              ((slide && slide.classList.contains('is-shown')) || (item && item.classList.contains('is-active')));

            if (inView && visible) {
              if (video.preload === 'none') video.preload = 'auto';
              var p = video.play();
              if (p && p.catch) p.catch(function () {});
            } else if (!video.paused) {
              video.pause();
            }
          });
        }

        function show(index) {
          shown = index;
          slides.forEach(function (slide, i) { slide.classList.toggle('is-shown', i === index); });
          syncVideos();
        }

        function select(index, scroll) {
          active = index;
          items.forEach(function (item, i) {
            var isActive = i === index;
            item.classList.toggle('is-active', isActive);
            triggers[i].setAttribute('aria-expanded', isActive ? 'true' : 'false');
          });
          show(index);

          if (scroll && !desktop.matches) {
            setTimeout(function () {
              var top = items[index].getBoundingClientRect().top;
              if (top < 0 || top > window.innerHeight * 0.4) {
                items[index].scrollIntoView({ behavior: 'smooth', block: 'start' });
              }
            }, 380);
          }
        }

        triggers.forEach(function (trigger, i) {
          trigger.addEventListener('click', function () { select(i, true); });

          trigger.addEventListener('mouseenter', function () {
            if (!desktop.matches || !finePointer.matches) return;
            clearTimeout(hoverTimer);
            hoverTimer = setTimeout(function () { show(i); }, 90);
          });

          trigger.addEventListener('focus', function () {
            if (desktop.matches) show(i);
          });

          trigger.addEventListener('keydown', function (event) {
            var next = null;
            if (event.key === 'ArrowDown') next = Math.min(i + 1, triggers.length - 1);
            if (event.key === 'ArrowUp') next = Math.max(i - 1, 0);
            if (event.key === 'Home') next = 0;
            if (event.key === 'End') next = triggers.length - 1;
            if (next !== null) { event.preventDefault(); triggers[next].focus(); }
          });
        });

        var list = section.querySelector('.nec__list');
        list.addEventListener('mouseleave', function () {
          clearTimeout(hoverTimer);
          if (shown !== active) show(active);
        });
        list.addEventListener('focusout', function (event) {
          if (!list.contains(event.relatedTarget) && shown !== active) show(active);
        });

        if ('IntersectionObserver' in window) {
          new IntersectionObserver(function (entries) {
            inView = entries[0].isIntersecting;
            syncVideos();
          }, { rootMargin: '100px 0px' }).observe(section);
        } else {
          inView = true;
          syncVideos();
        }

        var onChange = function () { syncVideos(); };
        desktop.addEventListener ? desktop.addEventListener('change', onChange) : desktop.addListener(onChange);

        section.addEventListener('shopify:block:select', function (event) {
          var index = items.findIndex(function (item) { return item.contains(event.target) || item === event.target; });
          if (index > -1) select(index, true);
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () { initNec(); }, { once: true });
    } else {
      initNec();
    }
    document.addEventListener('shopify:section:load', function (event) { initNec(event.target); });
  })();
</script>

<style>
  .nec {
    --nec-muted: rgb(var(--text-color) / 0.68);
    --nec-faint: rgb(var(--text-color) / 0.38);
    --nec-line: rgb(var(--text-color) / 0.14);
    --nec-ease: cubic-bezier(0.2, 0.65, 0.3, 1);
    padding-block: clamp(4rem, 8vw, 7.5rem);
  }

  .nec__layout {
    display: grid;
    gap: 2.5rem;
    max-width: 1440px;
    margin: 0 auto;
  }

  /* Cabecera */
  .nec__header { margin-bottom: clamp(2rem, 4vw, 3.5rem); }

  .nec__eyebrow {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0 0 1.25rem;
    color: var(--nec-muted);
    font: var(--subheading-font-style) var(--subheading-font-weight) 0.72rem / 1.2 var(--subheading-font-family);
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .nec__eyebrow::before {
    width: 2.5rem;
    height: 1px;
    background: rgb(var(--text-color) / 0.35);
    content: "";
  }

  .nec__title {
    margin: 0;
    color: rgb(var(--text-color));
    font: var(--heading-font-style) var(--heading-font-weight) clamp(2.4rem, 4.6vw, 4.25rem) / 1.02 var(--heading-font-family);
    letter-spacing: var(--heading-letter-spacing);
    text-wrap: balance;
  }

  .nec__subtitle {
    max-width: 34rem;
    margin-top: 1.25rem;
    color: var(--nec-muted);
    font-size: clamp(0.98rem, 1.2vw, 1.08rem);
    line-height: 1.7;
  }

  .nec__subtitle p { margin: 0; }
  .nec__subtitle p + p { margin-top: 0.75rem; }

  /* Lista */
  .nec__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--nec-line);
  }


  .nec__item {
    border-bottom: 1px solid var(--nec-line);
    scroll-margin-top: calc(var(--sticky-area-height, 0px) + 1rem);
  }

  .nec__item-heading { margin: 0; font: inherit; }

  .nec__trigger {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) auto;
    align-items: baseline;
    width: 100%;
    padding: 1.1rem 0;
    border: 0;
    background: none;
    color: var(--nec-faint);
    text-align: left;
    cursor: pointer;
    transition: color 260ms ease;
  }


  .nec__trigger:hover,
  .nec__trigger:focus-visible,
  .nec__item.is-active .nec__trigger { color: rgb(var(--text-color)); }

  .nec__trigger:focus-visible { outline: 1px solid rgb(var(--text-color)); outline-offset: 4px; }

  .nec__number {
    font: var(--heading-font-style) var(--heading-font-weight) 0.8rem / 1 var(--heading-font-family);
    letter-spacing: 0.08em;
  }

  .nec__label {
    font: var(--heading-font-style) var(--heading-font-weight) clamp(1.55rem, 2.5vw, 2.35rem) / 1.12 var(--heading-font-family);
    letter-spacing: var(--heading-letter-spacing);
    transition: transform 380ms var(--nec-ease);
  }


  .nec__icon {
    position: relative;
    width: 0.85rem;
    height: 0.85rem;
    align-self: center;
  }

  .nec__icon::before,
  .nec__icon::after {
    position: absolute;
    inset: 50% 0 auto;
    height: 1px;
    background: currentColor;
    transition: transform 380ms var(--nec-ease);
    content: "";
  }

  .nec__icon::after { transform: rotate(90deg); }
  .nec__item.is-active .nec__icon::after { transform: rotate(0deg); }

  /* Cuerpo desplegable */
  .nec__body {
    display: grid;
    grid-template-rows: 0fr;
    visibility: hidden;
    transition: grid-template-rows 420ms var(--nec-ease), visibility 0s linear 420ms;
  }

  .nec__item.is-active .nec__body {
    grid-template-rows: 1fr;
    visibility: visible;
    transition: grid-template-rows 420ms var(--nec-ease), visibility 0s;
  }

  .nec__body-inner {
    min-height: 0;
    overflow: hidden;
  }

  .nec__body-inner > :last-child { margin-bottom: 1.75rem; }

  .nec__inline-media {
    position: relative;
    aspect-ratio: 4 / 5;
    max-height: 72vh;
    margin-bottom: 1.5rem;
    overflow: hidden;
    background: rgb(var(--text-color) / 0.06);
  }

  .nec__question {
    margin: 0;
    color: rgb(var(--text-color));
    font: italic var(--heading-font-weight) clamp(1.1rem, 1.5vw, 1.3rem) / 1.45 var(--heading-font-family);
  }

  .nec__text {
    margin-top: 1rem;
    color: var(--nec-muted);
    font-size: clamp(0.96rem, 1.1vw, 1.03rem);
    line-height: 1.75;
  }

  .nec__details {
    display: grid;
    gap: 0.85rem;
    margin: 1.5rem 0 0;
    padding: 1.25rem 0 0;
    border-top: 1px solid var(--nec-line);
  }

  .nec__detail { display: grid; gap: 0.2rem; }

  .nec__detail dt {
    color: rgb(var(--text-color));
    font: var(--subheading-font-style) var(--subheading-font-weight) 0.7rem / 1.3 var(--subheading-font-family);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .nec__detail dd {
    margin: 0;
    color: var(--nec-muted);
    font-size: 0.94rem;
    line-height: 1.6;
  }

  .nec__highlight {
    margin: 1.5rem 0 0;
    padding-left: 1.1rem;
    border-left: 1px solid rgb(var(--text-color) / 0.45);
    color: rgb(var(--text-color));
    font: var(--heading-font-style) var(--heading-font-weight) clamp(1.1rem, 1.5vw, 1.3rem) / 1.45 var(--heading-font-family);
    text-wrap: pretty;
  }

  .nec__link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.5rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid rgb(var(--text-color) / 0.45);
    color: rgb(var(--text-color));
    font-size: 0.82rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition: gap 220ms ease, border-color 220ms ease;
  }

  .nec__link:hover { gap: 0.9rem; border-color: rgb(var(--text-color)); }

  /* Media */
  .nec-media {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Escenario (solo escritorio) */
  .nec__stage { display: none; }

  @media screen and (min-width: 1000px) {
    .nec__layout {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
      gap: clamp(3rem, 6vw, 6.5rem);
      align-items: start;
    }

    .nec__inline-media { display: none; }

    .nec__trigger { padding: 1.3rem 0; }
    .nec__trigger:hover .nec__label,
    .nec__item.is-active .nec__label { transform: translateX(0.4rem); }

    .nec__body-inner { padding-left: 2.25rem; }

    .nec__stage {
      display: block;
      position: sticky;
      top: calc(var(--sticky-area-height, 0px) + 2rem);
    }

    .nec__stage-frame {
      position: relative;
      height: min(calc(100vh - var(--sticky-area-height, 0px) - 4rem), 880px);
      min-height: 540px;
      overflow: hidden;
      background: rgb(var(--text-color) / 0.06);
    }

    .nec__slide {
      position: absolute;
      inset: 0;
      margin: 0;
      opacity: 0;
      transition: opacity 700ms var(--nec-ease);
    }

    .nec__slide.is-shown { opacity: 1; z-index: 1; }

    .nec__slide .nec-media {
      transform: scale(1.06);
      transition: transform 1600ms var(--nec-ease);
    }

    .nec__slide.is-shown .nec-media { transform: scale(1); }

    .nec__caption {
      position: absolute;
      inset: auto 0 0;
      display: flex;
      align-items: flex-end;
      gap: 1.25rem;
      padding: 6rem clamp(1.5rem, 3vw, 2.5rem) clamp(1.5rem, 3vw, 2.25rem);
      background: linear-gradient(to top, rgb(0 0 0 / 0.55), rgb(0 0 0 / 0));
      color: #fff;
    }

    .nec__caption-number {
      font: var(--heading-font-style) var(--heading-font-weight) clamp(4.5rem, 8vw, 7.5rem) / 0.8 var(--heading-font-family);
      letter-spacing: -0.04em;
      opacity: 0.92;
    }

    .nec__caption-text {
      display: grid;
      gap: 0.4rem;
      padding-bottom: 0.35rem;
      opacity: 0;
      transform: translateY(8px);
      transition: opacity 600ms var(--nec-ease) 150ms, transform 600ms var(--nec-ease) 150ms;
    }

    .nec__slide.is-shown .nec__caption-text { opacity: 1; transform: none; }


    .nec__caption-title {
      font: var(--heading-font-style) var(--heading-font-weight) clamp(1.5rem, 2.2vw, 2.1rem) / 1.1 var(--heading-font-family);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nec__body,
    .nec__item.is-active .nec__body,
    .nec__slide,
    .nec__slide .nec-media,
    .nec__caption-text,
    .nec__label { transition: none; }
  }
</style>
{%- endif -%}

{% schema %}
{
  "name": "Selector de necesidades",
  "tag": "div",
  "class": "shopify-section--necesidades-selector",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-2" },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Qué podemos tratar" },
    { "type": "inline_richtext", "id": "title", "label": "Título", "default": "Necesidades que podemos <em>trabajar</em>" },
    { "type": "richtext", "id": "subtitle", "label": "Subtítulo" }
  ],
  "blocks": [
    {
      "type": "need",
      "name": "Necesidad",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Necesidad" },
        { "type": "image_picker", "id": "image", "label": "Imagen", "info": "Mejor en vertical. Si añades vídeo, la imagen se usa como portada mientras carga." },
        { "type": "video", "id": "video", "label": "Vídeo", "info": "Se reproduce en bucle y sin sonido. Mejor vertical y de 8–20 s." },
        { "type": "textarea", "id": "question", "label": "Pregunta / gancho" },
        { "type": "richtext", "id": "content", "label": "Texto" },
        { "type": "header", "content": "Detalles (opcional)" },
        { "type": "text", "id": "detail_1_title", "label": "Detalle 1 · título" },
        { "type": "textarea", "id": "detail_1_text", "label": "Detalle 1 · texto" },
        { "type": "text", "id": "detail_2_title", "label": "Detalle 2 · título" },
        { "type": "textarea", "id": "detail_2_text", "label": "Detalle 2 · texto" },
        { "type": "text", "id": "detail_3_title", "label": "Detalle 3 · título" },
        { "type": "textarea", "id": "detail_3_text", "label": "Detalle 3 · texto" },
        { "type": "header", "content": "Cierre" },
        { "type": "textarea", "id": "highlight", "label": "Frase destacada" },
        { "type": "text", "id": "button_text", "label": "Enlace · texto", "info": "Ej.: Ver tratamiento drenante" },
        { "type": "url", "id": "button_link", "label": "Enlace · URL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Selector de necesidades",
      "blocks": [{ "type": "need" }, { "type": "need" }, { "type": "need" }]
    }
  ]
}
{% endschema %}
