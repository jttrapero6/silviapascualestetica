<div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
  <div class="container section-spacing">
    <div class="section-stack max-w-lg mx-auto text-center">
      {%- if section.settings.title != blank -%}
        {%- render 'heading', content: section.settings.title, style: section.settings.heading_size, html_tag: 'h2' -%}
      {%- endif -%}

      {%- if section.settings.content != blank -%}
        <div class="prose prose-justify-center">{{ section.settings.content }}</div>
      {%- endif -%}

      {%- form 'contact', class: 'form' -%}
        {%- if form.posted_successfully? -%}
          {%- render 'banner', status: 'success', content: 'Envíado correctamente', text_alignment: 'center' -%}
        {%- endif -%}

        {%- if form.errors -%}
          {%- capture error_message -%}{{ form.errors.translated_fields[form.errors.first] | capitalize }} {{ form.errors.messages[form.errors.first] }}{%- endcapture -%}
          {%- render 'banner', status: 'error', content: error_message, text_alignment: 'center' -%}
        {%- endif -%}

        {%- render 'input', type: 'hidden', name: 'contact[email]', value: shop.email -%}

        <div class="fieldset">
          <div class="fieldset-row">
            {%- render 'input', type: 'text', name: 'contact[name]', label: 'Nombre', required: true, autocomplete: 'name' -%}
            {%- render 'input', type: 'tel', name: 'contact[phone]', label: 'Teléfono', required: true, autocomplete: 'tel', placeholder: 'Ej: 600 123 456' -%}
          </div>

          {%- assign options = 'Tratamientos corporales,Tratamientos faciales,Masajes,Maquillaje' | split: ',' -%}
          {%- render 'select', name: 'contact[motivo]', label: 'Selecciona una opción', option_values: options, show_empty_value: true, required: true -%}

          {%- render 'input', name: 'contact[body]', label: 'Mensaje', multiline: 5, required: true -%}
        </div>

        <div>
          {%- render 'button', content: 'Enviar mensaje', type: 'submit' -%}
        </div>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Formulario Tratamientos",
  "class": "shopify-section--custom-contact",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Título",
      "default": "Contáctanos"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "display-xl", "label": "Display XL" },
        { "value": "display-l", "label": "Display L" },
        { "value": "display-m", "label": "Display M" },
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Contenido",
      "default": "<p>Por favor completa el formulario y nos pondremos en contacto contigo lo antes posible.</p>"
    }
  ],
  "presets": [
    {
      "name": "Formulario Tratamientos",
      "category": "Call to action",
      "settings": {}
    }
  ]
}
{% endschema %}
