<div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
  <div class="container section-spacing">
    <div class="contact-map-section">
      <div class="contact-map-section__map">
        {%- if section.settings.map_iframe != blank -%}
          <div class="contact-map-section__embed">
            {{- section.settings.map_iframe -}}
          </div>
        {%- elsif section.settings.map_image != blank -%}
          <div class="contact-map-section__image">
            {{- section.settings.map_image | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '(min-width: 1000px) 50vw, 100vw', class: 'contact-map-section__image-media', alt: section.settings.map_image_alt | default: 'Mapa del centro' -}}
          </div>
        {%- else -%}
          <div class="contact-map-section__map-viewport"
               id="contact-map-{{ section.id }}"
               data-lat="{{ section.settings.map_latitude | default: 40.4168 }}"
               data-lng="{{ section.settings.map_longitude | default: -3.7038 }}"
               data-zoom="{{ section.settings.map_zoom | default: 15 }}"
               data-map-link="{{ section.settings.map_link | escape }}"
               aria-label="{{ section.settings.map_fallback_text | default: 'Mapa del centro' }}"></div>
        {%- endif -%}
      </div>

      <div class="contact-map-section__content">
        {%- if section.settings.title != blank -%}
          {%- render 'heading', content: section.settings.title, style: section.settings.heading_size, html_tag: 'h2' -%}
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="contact-map-section__intro prose">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="contact-map-section__items">
            {%- for block in section.blocks -%}
              {%- assign item_type = block.settings.type -%}
              {%- assign item_value = block.settings.value -%}
              {%- assign item_label = block.settings.label | default: item_value -%}
              {%- assign item_url = block.settings.url -%}

              {%- case item_type -%}
                {%- when 'phone' -%}
                  {%- assign item_url = 'tel:' | append: item_value | replace: ' ', '' -%}
                {%- when 'email' -%}
                  {%- assign item_url = 'mailto:' | append: item_value -%}
                {%- when 'whatsapp' -%}
                  {%- assign whatsapp_value = item_value | replace: ' ', '' | replace: '+', '' -%}
                  {%- assign item_url = 'https://wa.me/' | append: whatsapp_value -%}
                {%- when 'custom' -%}
                  {%- assign item_url = block.settings.url -%}
              {%- endcase -%}

              {%- if item_value == blank -%}{%- continue -%}{%- endif -%}

              <div class="contact-map-section__item" {{ block.shopify_attributes }}>
                <div class="contact-map-section__icon">
                  {%- if block.settings.custom_icon != blank -%}
                    {%- render 'icon', image: block.settings.custom_icon, width: 22, mobile_width: 20 -%}
                  {%- elsif block.settings.icon != blank and block.settings.icon != 'none' -%}
                    {%- render 'icon' with block.settings.icon, width: 22, mobile_width: 20 -%}
                  {%- endif -%}
                </div>

                <div class="contact-map-section__details">
                  {%- if item_label != blank and item_label != item_value -%}
                    <span class="contact-map-section__label">{{ item_label }}</span>
                  {%- endif -%}

                  {%- if item_url != blank -%}
                    <a href="{{ item_url }}" {% if block.settings.open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}>
                      {{- item_value -}}
                    </a>
                  {%- else -%}
                    <span>{{ item_value }}</span>
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} .contact-map-section {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1.3fr);
    gap: 7.5rem;
    align-items: stretch;
    margin-left: 0;
    margin-right: 0;
    width: calc(100% + 0px);
    padding: 0;
  }

  #shopify-section-{{ section.id }} .contact-map-section__map,
  #shopify-section-{{ section.id }} .contact-map-section__content {
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .contact-map-section__map {
    display: flex;
    order: 1;
  }

  #shopify-section-{{ section.id }} .contact-map-section__content {
    order: 2;
  }

  #shopify-section-{{ section.id }} .contact-map-section__embed,
  #shopify-section-{{ section.id }} .contact-map-section__image,
  #shopify-section-{{ section.id }} .contact-map-section__placeholder,
  #shopify-section-{{ section.id }} .contact-map-section__map-viewport {
    width: 100%;
    min-height: 430px;
    overflow: hidden;
    background: linear-gradient(135deg, rgba(var(--color-foreground), 0.04), rgba(var(--color-foreground), 0.02));
    border: 1px solid rgba(var(--color-foreground), 0.08);
    box-shadow: 0 20px 45px rgba(var(--color-foreground), 0.06);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .contact-map-section__embed iframe,
  #shopify-section-{{ section.id }} .contact-map-section__image-media,
  #shopify-section-{{ section.id }} .contact-map-section__map-viewport .leaflet-container {
    width: 100%;
    height: 100%;
    min-height: 430px;
    display: block;
    border: 0;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .contact-map-section__map-viewport .leaflet-container {
    background: rgba(var(--color-background), 0.4);
  }

  #shopify-section-{{ section.id }} .contact-map-section__map-viewport .leaflet-tile-pane {
    filter: grayscale(1) contrast(1.08);
  }

  #shopify-section-{{ section.id }} .contact-map-section__map-viewport .contact-map-leaflet-icon {
    background: transparent;
    border: 0;
  }

  #shopify-section-{{ section.id }} .contact-map-section__map-viewport .contact-map-pin {
    position: relative;
    display: block;
    width: 30px;
    height: 30px;
    border: 2px solid #1a1a1a;
    border-radius: 50% 50% 50% 0;
    background: #fff;
    box-shadow: 0 3px 8px rgba(0, 0, 0, 0.2);
    transform: rotate(-45deg);
  }

  #shopify-section-{{ section.id }} .contact-map-section__map-viewport .contact-map-pin::after {
    position: absolute;
    top: 8px;
    left: 8px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #1a1a1a;
    content: '';
  }

  #shopify-section-{{ section.id }} .contact-map-section__map-viewport .leaflet-control-attribution,
  #shopify-section-{{ section.id }} .contact-map-section__map-viewport .leaflet-control-zoom {
    border: 0;
    box-shadow: 0 10px 20px rgba(var(--color-foreground), 0.08);
  }

  #shopify-section-{{ section.id }} .contact-map-section__placeholder {
    border: 1px solid rgba(var(--color-foreground), 0.12);
    color: rgb(var(--color-foreground));
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.75rem;
    background: rgba(var(--color-foreground), 0.015);
  }

  #shopify-section-{{ section.id }} .contact-map-section__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.5rem;
    padding: clamp(1.25rem, 2vw, 2rem);
    border: 1px solid rgba(var(--color-foreground), 0.08);
    border-radius: 1.5rem;
    background: linear-gradient(180deg, rgba(var(--color-foreground), 0.02), rgba(var(--color-foreground), 0.015));
    box-shadow: 0 12px 30px rgba(var(--color-foreground), 0.04);
  }

  #shopify-section-{{ section.id }} .contact-map-section__intro {
    margin: 0;
    color: rgba(var(--color-foreground), 0.8);
  }

  #shopify-section-{{ section.id }} .contact-map-section__items {
    display: grid;
    gap: 0.9rem;
  }

  #shopify-section-{{ section.id }} .contact-map-section__item {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 0.9rem 1rem;
    border-radius: 1rem;
    background: rgba(var(--color-background), 0.7);
    border: 1px solid rgba(var(--color-foreground), 0.08);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  #shopify-section-{{ section.id }} .contact-map-section__item:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 18px rgba(var(--color-foreground), 0.05);
  }

  #shopify-section-{{ section.id }} .contact-map-section__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.9rem;
    background: rgba(var(--color-foreground), 0.04);
    color: rgb(var(--color-foreground));
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .contact-map-section__details {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .contact-map-section__label {
    display: block;
    color: rgba(var(--color-foreground), 0.7);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .contact-map-section__details a,
  #shopify-section-{{ section.id }} .contact-map-section__details span {
    color: rgb(var(--color-foreground));
    text-decoration: none;
    word-break: break-word;
    line-height: 1.5;
  }

  @media screen and (max-width: 799px) {
    #shopify-section-{{ section.id }} .contact-map-section {
      grid-template-columns: 1fr;
      gap: 0;
      width: 100vw;
      margin-left: calc(50% - 50vw);
      margin-right: calc(50% - 50vw);
      padding: 0;
      border-radius: 0;
    }

    #shopify-section-{{ section.id }} .contact-map-section__content {
      order: 1;
      padding: 1.1rem;
      border-radius: 0;
    }

    #shopify-section-{{ section.id }} .contact-map-section__map {
      order: 2;
    }

    #shopify-section-{{ section.id }} .contact-map-section__embed,
    #shopify-section-{{ section.id }} .contact-map-section__image,
    #shopify-section-{{ section.id }} .contact-map-section__placeholder,
    #shopify-section-{{ section.id }} .contact-map-section__map-viewport {
      min-height: 280px;
      border-radius: 0;
      border-left: 0;
      border-right: 0;
      border-top: 1px solid rgba(var(--color-foreground), 0.08);
      border-bottom: 1px solid rgba(var(--color-foreground), 0.08);
      box-shadow: none;
    }

    #shopify-section-{{ section.id }} .contact-map-section__map-viewport .leaflet-container,
    #shopify-section-{{ section.id }} .contact-map-section__embed iframe,
    #shopify-section-{{ section.id }} .contact-map-section__image-media {
      min-height: 280px;
    }
  }
</style>

{% unless section.settings.map_iframe != blank or section.settings.map_image != blank %}
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" defer></script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var mapElement = document.getElementById('contact-map-{{ section.id }}');
      if (!mapElement || !window.L || mapElement.dataset.ready === 'true') return;

      var lat = parseFloat(mapElement.dataset.lat || '40.4168');
      var lng = parseFloat(mapElement.dataset.lng || '-3.7038');
      var zoom = parseInt(mapElement.dataset.zoom || '15', 10);
      var mapLink = mapElement.dataset.mapLink;

      var map = L.map(mapElement, {
        zoomControl: true,
        scrollWheelZoom: false,
        dragging: true,
        attributionControl: true
      }).setView([lat, lng], zoom);

      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>',
        subdomains: 'abc',
        maxZoom: 20
      }).addTo(map);

      var pinIcon = L.divIcon({
        className: 'contact-map-leaflet-icon',
        html: '<span class="contact-map-pin" aria-hidden="true"></span>',
        iconSize: [32, 42],
        iconAnchor: [16, 40]
      });

      var marker = L.marker([lat, lng], {
        icon: pinIcon,
        keyboard: true,
        title: mapLink ? 'Abrir ubicación en Google Maps' : 'Ubicación del centro'
      }).addTo(map);

      if (mapLink) {
        marker.on('click', function () {
          window.open(mapLink, '_blank', 'noopener,noreferrer');
        });
        marker.bindTooltip('Abrir ubicación en Google Maps');
      } else {
        marker.bindTooltip('Ubicación del centro');
      }

      mapElement.dataset.ready = 'true';
      setTimeout(function () {
        map.invalidateSize();
      }, 200);
    });
  </script>
{% endunless %}

{% schema %}
{
  "name": "Ubicación centro",
  "class": "shopify-section--contact-map",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Título",
      "default": "Encuéntranos"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Tamaño del título",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto introductorio",
      "default": "<p>Visítanos en nuestro centro y consulta cualquier duda sobre tratamientos o reservas.</p>"
    },
    {
      "type": "image_picker",
      "id": "map_image",
      "label": "Imagen del mapa"
    },
    {
      "type": "text",
      "id": "map_image_alt",
      "label": "Texto alternativo de la imagen del mapa",
      "default": "Mapa del centro"
    },
    {
      "type": "header",
      "content": "Mapa sin Google"
    },
    {
      "type": "url",
      "id": "map_link",
      "label": "Enlace al mapa externo",
      "info": "Opcional. Al pulsar la chincheta, abrirá este enlace en una pestaña nueva."
    },
    {
      "type": "text",
      "id": "map_latitude",
      "label": "Latitud",
      "default": "40.4168",
      "info": "Usado cuando no hay iframe ni imagen. Ajusta la ubicación exacta del centro."
    },
    {
      "type": "text",
      "id": "map_longitude",
      "label": "Longitud",
      "default": "-3.7038",
      "info": "Usado cuando no hay iframe ni imagen. Ajusta la ubicación exacta del centro."
    },
    {
      "type": "range",
      "id": "map_zoom",
      "label": "Zoom del mapa",
      "min": 10,
      "max": 25,
      "step": 1,
      "default": 15
    },
    {
      "type": "textarea",
      "id": "map_iframe",
      "label": "Iframe o HTML del mapa",
      "info": "Puedes pegar aquí un iframe de Google Maps o cualquier código HTML del mapa. Si lo rellenas, tiene prioridad sobre la imagen."
    },
    {
      "type": "text",
      "id": "map_fallback_text",
      "label": "Texto alternativo si no hay mapa",
      "default": "Mapa del centro"
    }
  ],
  "blocks": [
    {
      "type": "info_item",
      "name": "Datos de contacto",
      "settings": [
        {
          "type": "select",
          "id": "type",
          "label": "Tipo de dato",
          "options": [
            { "value": "phone", "label": "Teléfono" },
            { "value": "email", "label": "Email" },
            { "value": "whatsapp", "label": "WhatsApp" },
            { "value": "address", "label": "Dirección" },
            { "value": "custom", "label": "Personalizado" }
          ],
          "default": "phone"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Etiqueta",
          "default": "Teléfono"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Texto o dato",
          "default": "+34 600 123 456"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Enlace opcional"
        },
        {
          "type": "checkbox",
          "id": "open_new_tab",
          "label": "Abrir enlace en nueva pestaña",
          "default": false
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "options": [
            { "value": "none", "label": "Sin icono" },
            { "value": "picto-phone", "label": "Teléfono" },
            { "value": "picto-email", "label": "Email" },
            { "value": "picto-mobile-phone", "label": "Móvil" },
            { "value": "picto-location-pin", "label": "Ubicación" },
            { "value": "picto-chat", "label": "Chat" },
            { "value": "picto-customer-support", "label": "Soporte" },
            { "value": "picto-date", "label": "Horario" },
            { "value": "whatsapp", "label": "WhatsApp" }
          ],
          "default": "picto-phone"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Icono personalizado"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ubicación centro",
      "blocks": [
        {
          "type": "info_item",
          "settings": {
            "type": "phone",
            "label": "Teléfono",
            "value": "+34 600 123 456",
            "icon": "picto-phone"
          }
        },
        {
          "type": "info_item",
          "settings": {
            "type": "whatsapp",
            "label": "WhatsApp",
            "value": "+34 600 123 456",
            "icon": "whatsapp"
          }
        },
        {
          "type": "info_item",
          "settings": {
            "type": "email",
            "label": "Email",
            "value": "hola@centroestetica.com",
            "icon": "picto-email"
          }
        },
        {
          "type": "info_item",
          "settings": {
            "type": "address",
            "label": "Dirección",
            "value": "Calle Ejemplo 123, 28001 Madrid",
            "icon": "picto-location-pin"
          }
        }
      ]
    }
  ]
}
{% endschema %}
