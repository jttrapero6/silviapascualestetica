{%- liquid
  assign form_id = section.id | append: '-floating-atc-form'

  if product.selected_or_first_available_variant == nil
    assign button_label = 'product.general.unavailable_button' | t
    assign disabled = true
  elsif product.selected_or_first_available_variant.available == false
    assign button_label = 'product.general.sold_out_button' | t
    assign disabled = true
  else
    assign button_label = 'product.general.add_to_cart_button' | t
    assign disabled = false
  endif

  assign mobile_button_label = button_label
  if disabled == false
    assign formatted_price = product.selected_or_first_available_variant.price | money
    assign mobile_button_label = button_label | append: ' · ' | append: formatted_price
  endif
-%}

<style>
  #shopify-section-{{ section.id }} {
    position: fixed;
    inset-block-end: 1.75rem;
    inset-inline-end: 1.75rem;
    z-index: 3;
    width: min(100%,40rem);
  }

  #shopify-section-{{ section.id }} floating-atc-button {
    border-width: 1px;
    grid-template-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    justify-content: space-between;
    align-items: center;
    width: min(100%, 40rem);
    padding: 1rem 2rem 1rem 1rem;
    display: grid;
    box-shadow: 0 2px 4px #0000000d;
  }

  #shopify-section-{{ section.id }} floating-atc-button product-form,
  #shopify-section-{{ section.id }} floating-atc-button product-form form {
    display: contents;
  }

  @media screen and (max-width: 699px) {
    #shopify-section-{{ section.id }} {
      inset-block-end: 0;
      inset-inline-start: 0;
      inset-inline-end: 0;
    }

    #shopify-section-{{ section.id }} floating-atc-button {
      box-shadow: none;
      background: none;
      border: none;
      padding: 1rem;
    }
  }
</style>

<floating-atc-button class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
  <product-form>
    {%- form 'product', product, id: form_id -%}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

      <div class="h-stack gap-6 sm-max:hidden">
        {%- assign image = product.selected_or_first_available_variant.featured_media | default: product.featured_media -%}

        {%- if image != blank -%}
          {{- image | image_url: width: image.width | image_tag: loading: 'lazy', widths: '70,140,210,280', class: 'constrained-image', style: '--image-max-width: 70px' -}}
        {%- endif -%}

        <div class="v-stack gap-0.5">
          <span class="subheading">{{ product.title }}</span>

          {%- unless product.has_only_default_variant -%}
            <span class="subheading text-subdued">{{ product.selected_or_first_available_variant.title }}</span>
          {%- endunless -%}

          {%- render 'price-list', variant: product.selected_or_first_available_variant, context: 'line_item' -%}
        </div>
      </div>

      <buy-buttons class="buy-buttons" form="{{ form_id }}">
        {%- render 'button', type: 'submit', form: form_id, content: button_label, disabled: disabled, style: 'outline', class: 'sm-max:hidden' -%}
        {%- render 'button', type: 'submit', form: form_id, content: mobile_button_label, disabled: disabled, style: 'solid', class: 'sm:hidden floating-atc-button__mobile' -%}
      </buy-buttons>
    {%- endform -%}
  </product-form>
</floating-atc-button>

<script>
  (() => {
    if (customElements.get('floating-atc-button')) return;

    const addLabel = {{ 'product.general.add_to_cart_button' | t | json }};
    const soldOutLabel = {{ 'product.general.sold_out_button' | t | json }};
    const unavailableLabel = {{ 'product.general.unavailable_button' | t | json }};
    const moneyFormat = {{ shop.money_format | json }};

    const formatMoney = (cents) => {
      if (typeof cents === 'string') cents = cents.replace('.', '');

      const format = (number, precision, thousands = ',', decimal = '.') => {
        number = (Number(number) / 100).toFixed(precision);
        const [whole, fraction] = number.split('.');
        const wholeFormatted = whole.replace(/(\d)(?=(\d{3})+(?!\d))/g, `$1${thousands}`);
        return fraction ? wholeFormatted + decimal + fraction : wholeFormatted;
      };

      return moneyFormat.replace(/\{\{\s*(\w+)\s*\}\}/, (match, placeholder) => {
        switch (placeholder) {
          case 'amount': return format(cents, 2);
          case 'amount_no_decimals': return format(cents, 0);
          case 'amount_with_comma_separator': return format(cents, 2, '.', ',');
          case 'amount_no_decimals_with_comma_separator': return format(cents, 0, '.', ',');
          case 'amount_with_space_separator': return format(cents, 2, ' ', ',');
          case 'amount_no_decimals_with_space_separator': return format(cents, 0, ' ', ',');
          case 'amount_with_apostrophe_separator': return format(cents, 2, "'", '.');
          default: return format(cents, 2);
        }
      });
    };

    customElements.define('floating-atc-button', class extends HTMLElement {
      connectedCallback() {
        this._onVariantChange = this._syncVariant.bind(this);
        document.addEventListener('variant:change', this._onVariantChange);
      }

      disconnectedCallback() {
        document.removeEventListener('variant:change', this._onVariantChange);
      }

      _syncVariant(event) {
        const variant = event.detail.variant;
        const idInput = this.querySelector('input[name="id"]');
        const buttons = this.querySelectorAll('button[type="submit"]');

        if (!idInput || !buttons.length) return;

        let label, isDisabled;

        if (!variant) {
          label = unavailableLabel;
          isDisabled = true;
          idInput.value = '';
        } else if (!variant.available) {
          label = soldOutLabel;
          isDisabled = true;
          idInput.value = variant.id;
        } else {
          label = addLabel;
          isDisabled = false;
          idInput.value = variant.id;
        }

        buttons.forEach((button) => {
          button.disabled = isDisabled;

          let buttonLabel = label;
          if (!isDisabled && button.classList.contains('floating-atc-button__mobile')) {
            buttonLabel = `${label} · ${formatMoney(variant.price)}`;
          }

          const buttonContent = button.querySelector('button-content');
          if (buttonContent) {
            buttonContent.textContent = buttonLabel;
            if (buttonContent.hasAttribute('rotated-text')) buttonContent.setAttribute('rotated-text', buttonLabel);
            if (buttonContent.hasAttribute('up-text')) buttonContent.setAttribute('up-text', buttonLabel);
          }
        });
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Botón flotante",
  "limit": 1,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Botón flotante añadir al carrito"
    }
  ]
}
{% endschema %}
