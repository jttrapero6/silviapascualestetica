          "default": "<p>Cada piel es única. Por eso escuchamos, analizamos y diseñamos tratamientos adaptados a las necesidades de cada persona.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Nuestros valores",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "number": "01",
            "title": "Cuidado personalizado",
            "content": "<p>Cada piel es única. Por eso escuchamos, analizamos y diseñamos tratamientos adaptados a las necesidades de cada persona.</p>"
