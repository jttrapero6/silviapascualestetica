{%- liquid
  assign separator = section.settings.separator | default: '/'
  assign home_label = section.settings.home_label | default: 'Inicio'
  assign show_home = section.settings.show_home
  assign show_product_name = section.settings.show_product_name
  assign show_vendor = section.settings.show_vendor
-%}

{%- capture breadcrumb_items -%}
  {%- if show_home -%}
    <li class="breadcrumb__item">
      <a href="{{ routes.root_url }}" class="breadcrumb__link">{{ home_label }}</a>
    </li>
    <li class="breadcrumb__separator" aria-hidden="true">{{ separator }}</li>
  {%- endif -%}

  {%- case template.name -%}
    {%- when 'product' -%}
      {%- if show_vendor and product.vendor != blank -%}
        {%- assign vendor_name = product.vendor | strip -%}
        {%- assign vendor_handle = vendor_name | handle -%}
        {%- assign vendor_collection = blank -%}

        {%- for collection in collections -%}
          {%- assign collection_title_handle = collection.title | handle -%}

          {%- if collection.title == vendor_name -%}
            {%- assign vendor_collection = collection -%}
            {%- break -%}
          {%- elsif collection.handle == vendor_handle -%}
            {%- assign vendor_collection = collection -%}
            {%- break -%}
          {%- elsif collection_title_handle == vendor_handle -%}
            {%- assign vendor_collection = collection -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}

        <li class="breadcrumb__item">
          {%- if vendor_collection != blank -%}
            <a href="{{ vendor_collection.url }}" class="breadcrumb__link">{{ product.vendor }}</a>
          {%- else -%}
            <span class="breadcrumb__link breadcrumb__link--static">{{ product.vendor }}</span>
          {%- endif -%}
        </li>
        <li class="breadcrumb__separator" aria-hidden="true">{{ separator }}</li>
      {%- endif -%}

      {%- if show_product_name -%}
        <li class="breadcrumb__item" aria-current="page">{{ product.title }}</li>
      {%- endif -%}

    {%- when 'collection' -%}
      {%- if show_product_name -%}
        <li class="breadcrumb__item" aria-current="page">{{ collection.title }}</li>
      {%- endif -%}

    {%- when 'article' -%}
      {%- if blog.title != blank -%}
        <li class="breadcrumb__item">
          <a href="{{ blog.url }}" class="breadcrumb__link">{{ blog.title }}</a>
        </li>
        <li class="breadcrumb__separator" aria-hidden="true">{{ separator }}</li>
      {%- endif -%}

      {%- if show_product_name -%}
        <li class="breadcrumb__item" aria-current="page">{{ article.title }}</li>
      {%- endif -%}

    {%- when 'blog' -%}
      {%- if show_product_name -%}
        <li class="breadcrumb__item" aria-current="page">{{ blog.title }}</li>
      {%- endif -%}

    {%- when 'page' -%}
      {%- if show_product_name -%}
        <li class="breadcrumb__item" aria-current="page">{{ page.title }}</li>
      {%- endif -%}

    {%- when 'search' -%}
      {%- if show_product_name -%}
        <li class="breadcrumb__item" aria-current="page">Resultados de búsqueda</li>
      {%- endif -%}

    {%- when 'cart' -%}
      {%- if show_product_name -%}
        <li class="breadcrumb__item" aria-current="page">Carrito</li>
      {%- endif -%}

    {%- else -%}
      {%- if show_product_name -%}
        <li class="breadcrumb__item" aria-current="page">{{ page_title | default: collection.title | default: product.title | default: blog.title | default: article.title | default: page.title }}</li>
      {%- endif -%}
  {%- endcase -%}
{%- endcapture -%}

{%- if breadcrumb_items != blank -%}
  <div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol class="breadcrumb__list unstyled-list">
          {{ breadcrumb_items }}
        </ol>
      </nav>
    </div>
  </div>
{%- endif -%}

<style>
  .breadcrumb {
    padding: 1.25rem 0 0.75rem;
  }

  .breadcrumb__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
    line-height: 1.4;
    color: rgb(var(--text-color) / 0.62);
  }

  .breadcrumb__item {
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
  }

  .breadcrumb__link,
  .breadcrumb__link--static {
    position: relative;
    display: inline-flex;
    align-items: center;
    color: rgb(var(--text-color) / 0.68);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .breadcrumb__link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -0.2rem;
    width: 100%;
    height: 1px;
    background: rgb(var(--text-color) / 0.5);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }

  .breadcrumb__link:hover {
    color: rgb(var(--text-color));
  }

  .breadcrumb__link:hover::after {
    transform: scaleX(1);
  }

  .breadcrumb__separator {
    color: rgb(var(--text-color) / 0.45);
    font-size: 0.8rem;
    line-height: 1;
  }

  .breadcrumb [aria-current="page"] {
    color: rgb(var(--text-color));
    font-weight: 500;
  }

  @media screen and (max-width: 749px) {
    .breadcrumb {
      padding-top: 1rem;
    }

    .breadcrumb__list {
      gap: 0.55rem;
    }
  }
</style>

{% schema %}
{
  "name": "Breadcrumb",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_home",
      "label": "Mostrar Inicio",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Mostrar proveedor",
      "default": true,
      "info": "Muestra el proveedor del producto en el breadcrumb."
    },
    {
      "type": "checkbox",
      "id": "show_product_name",
      "label": "Mostrar nombre del producto",
      "default": true
    },
    {
      "type": "text",
      "id": "home_label",
      "label": "Texto de Inicio",
      "default": "Inicio"
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Separador",
      "default": "/"
    }
  ],
  "presets": [
    {
      "name": "Breadcrumb"
    }
  ]
}
{% endschema %}
