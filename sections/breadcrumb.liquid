{%- liquid
  assign separator = section.settings.separator | default: '/'
  assign home_label = section.settings.home_label | default: 'Inicio'
  assign show_current_page = section.settings.show_current_page
  assign hide_collection = section.settings.hide_collection
-%}

{%- capture breadcrumb_items -%}
  {%- if section.settings.show_home -%}
    <li class="breadcrumb__item">
      <a href="{{ routes.root_url }}" class="breadcrumb__link">{{ home_label }}</a>
    </li>
    <li class="breadcrumb__separator" aria-hidden="true">{{ separator }}</li>
  {%- endif -%}

  {%- case template.name -%}
    {%- when 'product' -%}
      {%- unless hide_collection -%}
        {%- if product.collections.size > 0 -%}
          {%- assign collection = product.collections.first -%}
          <li class="breadcrumb__item">
            <a href="{{ collection.url }}" class="breadcrumb__link">{{ collection.title }}</a>
          </li>
          <li class="breadcrumb__separator" aria-hidden="true">{{ separator }}</li>
        {%- endif -%}
      {%- endunless -%}

      {%- if show_current_page -%}
        <li class="breadcrumb__item" aria-current="page">{{ product.title }}</li>
      {%- endif -%}

    {%- when 'collection' -%}
      {%- if show_current_page -%}
        <li class="breadcrumb__item" aria-current="page">{{ collection.title }}</li>
      {%- endif -%}

    {%- when 'article' -%}
      {%- if blog.title != blank -%}
        <li class="breadcrumb__item">
          <a href="{{ blog.url }}" class="breadcrumb__link">{{ blog.title }}</a>
        </li>
        <li class="breadcrumb__separator" aria-hidden="true">{{ separator }}</li>
      {%- endif -%}

      {%- if show_current_page -%}
        <li class="breadcrumb__item" aria-current="page">{{ article.title }}</li>
      {%- endif -%}

    {%- when 'blog' -%}
      {%- if show_current_page -%}
        <li class="breadcrumb__item" aria-current="page">{{ blog.title }}</li>
      {%- endif -%}

    {%- when 'page' -%}
      {%- if show_current_page -%}
        <li class="breadcrumb__item" aria-current="page">{{ page.title }}</li>
      {%- endif -%}

    {%- when 'search' -%}
      {%- if show_current_page -%}
        <li class="breadcrumb__item" aria-current="page">Resultados de búsqueda</li>
      {%- endif -%}

    {%- when 'cart' -%}
      {%- if show_current_page -%}
        <li class="breadcrumb__item" aria-current="page">Carrito</li>
      {%- endif -%}

    {%- else -%}
      {%- if show_current_page -%}
        <li class="breadcrumb__item" aria-current="page">{{ page_title | default: collection.title | default: product.title | default: blog.title | default: article.title | default: page.title }}</li>
      {%- endif -%}
  {%- endcase -%}
{%- endcapture -%}

{%- if breadcrumb_items != blank -%}
  <div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol class="breadcrumb__list unstyled-list">
          {{ breadcrumb_items }}
        </ol>
      </nav>
    </div>
  </div>
{%- endif -%}

<style>
  .breadcrumb {
    padding: 1.25rem 0 0.75rem;
  }

  .breadcrumb__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
    line-height: 1.4;
    color: rgb(var(--text-color) / 0.62);
  }

  .breadcrumb__item {
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
  }

  .breadcrumb__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    color: rgb(var(--text-color) / 0.68);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .breadcrumb__link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -0.2rem;
    width: 100%;
    height: 1px;
    background: rgb(var(--text-color) / 0.5);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }

  .breadcrumb__link:hover {
    color: rgb(var(--text-color));
  }

  .breadcrumb__link:hover::after {
    transform: scaleX(1);
  }

  .breadcrumb__separator {
    color: rgb(var(--text-color) / 0.45);
    font-size: 0.8rem;
    line-height: 1;
  }

  .breadcrumb [aria-current="page"] {
    color: rgb(var(--text-color));
    font-weight: 500;
  }

  @media screen and (max-width: 749px) {
    .breadcrumb {
      padding-top: 1rem;
    }

    .breadcrumb__list {
      letter-spacing: 0.12em;
      gap: 0.55rem;
    }
  }
</style>

{% schema %}
{
  "name": "Breadcrumb",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_home",
      "label": "Mostrar Inicio",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_current_page",
      "label": "Mostrar página actual",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_collection",
      "label": "Quitar colección",
      "default": false,
      "info": "Activa esta opción para mostrar solo Inicio / Nombre del producto."
    },
    {
      "type": "text",
      "id": "home_label",
      "label": "Texto de Inicio",
      "default": "Inicio"
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Separador",
      "default": "/"
    }
  ],
  "presets": [
    {
      "name": "Breadcrumb"
    }
  ]
}
{% endschema %}
