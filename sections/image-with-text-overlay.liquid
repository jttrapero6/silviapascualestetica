{%- liquid
  assign iwto_ratio = section.settings.aspect_ratio | default: 'original'
  assign iwto_mobile_ratio = section.settings.mobile_aspect_ratio | default: 'inherit'
  if iwto_mobile_ratio == 'inherit'
    assign iwto_mobile_ratio = iwto_ratio
  endif

  assign iwto_classes = 'iwto'
  assign iwto_style = ''

  if iwto_ratio != 'original'
    assign iwto_classes = iwto_classes | append: ' iwto--ratio'
    assign iwto_style = iwto_style | append: '--iwto-ratio: ' | append: iwto_ratio | append: ';'
  endif

  if iwto_mobile_ratio != 'original'
    assign iwto_classes = iwto_classes | append: ' iwto--ratio-mobile'
    assign iwto_style = iwto_style | append: '--iwto-ratio-mobile: ' | append: iwto_mobile_ratio | append: ';'
  endif

  case section.settings.mobile_layout
    when 'stack_top'
      assign iwto_classes = iwto_classes | append: ' iwto--stack iwto--stack-top'
    when 'stack_bottom'
      assign iwto_classes = iwto_classes | append: ' iwto--stack iwto--stack-bottom'
  endcase
-%}

<div {% if section.settings.allow_transparent_header %}allow-transparent-header{% endif %} class="{{ iwto_classes }} color-scheme color-scheme--{{ section.settings.color_scheme.id }}" {% if iwto_style != blank %}style="{{ iwto_style }}"{% endif %}>
  <div class="content-box min-h-{{ section.settings.image_size }}">
    <div class="content-box__background-media with-overlay" style="--overlay: {{ section.settings.overlay_color.rgb }} / {{ section.settings.overlay_opacity | divided_by: 100.0 }}">
      {%- liquid
        if section.settings.image != blank
          render 'media' with section.settings.image, mobile_media: section.settings.mobile_image, preload: true
        else
          echo 'hero-apparel-1' | placeholder_svg_tag: 'size-full'
        endif
      -%}
    </div>

    {%- capture blocks -%}{% content_for 'blocks' %}{%- endcapture -%}

    {%- if section.blocks.size > 0 -%}
      {%- assign mobile_text_alignment = section.settings.mobile_text_position | split: '-' | last -%}
      {%- assign desktop_text_alignment = section.settings.desktop_text_position | split: '-' | last -%}

      {%- if section.settings.enable_sticky_content -%}
        <div class="justify-self-{{ mobile_text_alignment }} sm:justify-self-{{ desktop_text_alignment }}">
          <div class="sticky">
            <div class="max-w-{{ section.settings.content_width }} prose prose-justify-{{ mobile_text_alignment }} sm:prose-justify-{{ desktop_text_alignment }}">
              {{- blocks -}}
            </div>
          </div>
        </div>
      {%- else -%}
        <div class="{{ section.settings.mobile_text_position }} {{ section.settings.desktop_text_position }}">
          <div class="max-w-{{ section.settings.content_width }} prose prose-justify-{{ mobile_text_alignment }} sm:prose-justify-{{ desktop_text_alignment }}">
            {{- blocks -}}
          </div>
        </div>
      {% endif %}
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  /* Aspect ratio (overlay mode) */
  @media screen and (min-width: 700px) {
    .iwto--ratio .content-box {
      aspect-ratio: var(--iwto-ratio);
      min-height: auto;
    }

    .iwto--ratio .content-box .content-box__background-media {
      position: absolute;
      inset: 0;
    }
  }

  @media screen and (max-width: 699px) {
    .iwto--ratio-mobile:not(.iwto--stack) .content-box {
      aspect-ratio: var(--iwto-ratio-mobile);
      min-height: auto;
    }

    .iwto--ratio-mobile:not(.iwto--stack) .content-box .content-box__background-media {
      position: absolute;
      inset: 0;
    }

    /* Stacked layout: media and text one above the other */
    .iwto.iwto--stack .content-box {
      grid-template-rows: auto auto;
      min-height: 0;
      aspect-ratio: auto;
    }

    .iwto.iwto--stack .content-box > .content-box__background-media.with-overlay {
      grid-column: full-start / full-end;
      grid-row: 1;
      position: relative;
      inset: auto;
      height: auto;
      aspect-ratio: var(--iwto-ratio-mobile, auto);
    }

    .iwto.iwto--stack .content-box > .content-box__background-media.with-overlay::after {
      display: none;
    }

    .iwto.iwto--stack .content-box > :not(.content-box__background-media) {
      grid-column: inner-start / inner-end;
      grid-row: 2;
      padding-block: var(--content-box-spacing);
    }

    .iwto.iwto--stack-top .content-box > .content-box__background-media.with-overlay {
      grid-row: 2;
    }

    .iwto.iwto--stack-top .content-box > :not(.content-box__background-media) {
      grid-row: 1;
      padding-block-start: calc(var(--content-box-spacing) + var(--content-box-enable-transparent-header-compensation) * var(--header-height, 0px));
    }
  }
{% endstylesheet %}

