{%- comment -%}
  Tratamiento destacado: media a sangre + ficha editorial con beneficios, datos clave y CTA.
{%- endcomment -%}
<section class="trat-destacado color-scheme color-scheme--{{ section.settings.color_scheme.id }}{% if section.settings.media_position == 'right' %} trat-destacado--media-right{% endif %}">
  <div class="trat-destacado__grid">
    <div class="trat-destacado__media">
      {%- if section.settings.video != blank -%}
        {%- render 'media', media: section.settings.video, autoplay: true, loop: true, muted: true, controls: false -%}
      {%- elsif section.settings.image != blank -%}
        {{- section.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', sizes: '(max-width: 999px) 100vw, 50vw', widths: '600,800,1000,1200,1500,1800' -}}
      {%- else -%}
        {{- 'lifestyle-2' | placeholder_svg_tag -}}
      {%- endif -%}

      {%- if section.settings.badge != blank -%}
        <span class="trat-destacado__badge">{{ section.settings.badge }}</span>
      {%- endif -%}
    </div>

    <div class="trat-destacado__content">
      <div class="trat-destacado__inner">
        {%- if section.settings.eyebrow != blank -%}
          <p class="trat-destacado__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        {%- if section.settings.title != blank -%}
          <h2 class="trat-destacado__title">{{ section.settings.title }}</h2>
        {%- endif -%}

        {%- if section.settings.tagline != blank -%}
          <p class="trat-destacado__tagline">{{ section.settings.tagline }}</p>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="trat-destacado__text prose">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="trat-destacado__features" role="list">
            {%- for block in section.blocks -%}
              <li class="trat-destacado__feature" {{ block.shopify_attributes }}>
                <span class="trat-destacado__feature-title">{{ block.settings.title }}</span>
                {%- if block.settings.text != blank -%}
                  <span class="trat-destacado__feature-text">{{ block.settings.text }}</span>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- liquid
          assign has_facts = false
          if section.settings.fact_1_value != blank or section.settings.fact_2_value != blank or section.settings.fact_3_value != blank
            assign has_facts = true
          endif
        -%}
        {%- if has_facts -%}
          <dl class="trat-destacado__facts">
            {%- for i in (1..3) -%}
              {%- assign f_value_key = 'fact_' | append: i | append: '_value' -%}
              {%- assign f_label_key = 'fact_' | append: i | append: '_label' -%}
              {%- if section.settings[f_value_key] != blank -%}
                <div class="trat-destacado__fact">
                  <dt>{{ section.settings[f_label_key] }}</dt>
                  <dd>{{ section.settings[f_value_key] }}</dd>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </dl>
        {%- endif -%}

        {%- if section.settings.button_text != blank and section.settings.button_link != blank -%}
          <div class="trat-destacado__cta">
            {%- render 'button', content: section.settings.button_text, href: section.settings.button_link, style: section.settings.button_style -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  .trat-destacado {
    --td-muted: rgb(var(--text-color) / 0.72);
    --td-line: rgb(var(--text-color) / 0.18);
  }

  .trat-destacado__grid {
    display: grid;
  }

  .trat-destacado__media {
    position: relative;
    min-height: 420px;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .trat-destacado__media img,
  .trat-destacado__media video,
  .trat-destacado__media svg,
  .trat-destacado__media video-media {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .trat-destacado__badge {
    position: absolute;
    top: clamp(1rem, 2.5vw, 2rem);
    left: clamp(1rem, 2.5vw, 2rem);
    padding: 0.55rem 1rem;
    border: 1px solid rgb(255 255 255 / 0.55);
    border-radius: 999px;
    background: rgb(0 0 0 / 0.18);
    backdrop-filter: blur(6px);
    color: #fff;
    font: var(--subheading-font-style) var(--subheading-font-weight) 0.68rem / 1 var(--subheading-font-family);
    letter-spacing: 0.25em;
    text-transform: uppercase;
  }

  .trat-destacado__content {
    display: flex;
    align-items: center;
    padding: clamp(3rem, 7vw, 7rem) var(--container-gutter, 1.25rem);
  }

  .trat-destacado__inner {
    width: 100%;
    max-width: 36rem;
  }

  .trat-destacado__eyebrow {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0 0 1.5rem;
    color: var(--td-muted);
    font: var(--subheading-font-style) var(--subheading-font-weight) 0.72rem / 1.2 var(--subheading-font-family);
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .trat-destacado__eyebrow::before {
    width: 2.5rem;
    height: 1px;
    background: rgb(var(--text-color) / 0.4);
    content: "";
  }

  .trat-destacado__title {
    margin: 0;
    color: rgb(var(--text-color));
    font: var(--heading-font-style) var(--heading-font-weight) clamp(3rem, 6vw, 5.5rem) / 0.95 var(--heading-font-family);
    letter-spacing: var(--heading-letter-spacing);
  }

  .trat-destacado__tagline {
    margin: 1.1rem 0 0;
    color: rgb(var(--text-color) / 0.85);
    font: italic var(--heading-font-weight) clamp(1.1rem, 1.6vw, 1.35rem) / 1.4 var(--heading-font-family);
  }

  .trat-destacado__text {
    margin-top: 1.75rem;
    color: var(--td-muted);
    font-size: clamp(0.98rem, 1.2vw, 1.05rem);
    line-height: 1.75;
  }

  .trat-destacado__features {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 2rem;
    margin: 2.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .trat-destacado__feature {
    display: grid;
    gap: 0.4rem;
    padding-top: 1rem;
    border-top: 1px solid var(--td-line);
  }

  .trat-destacado__feature-title {
    color: rgb(var(--text-color));
    font: var(--heading-font-style) var(--heading-font-weight) 1.2rem / 1.2 var(--heading-font-family);
  }

  .trat-destacado__feature-text {
    color: var(--td-muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .trat-destacado__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2.5rem;
    margin: 2.25rem 0 0;
    padding: 1.5rem 0 0;
    border-top: 1px solid var(--td-line);
  }

  .trat-destacado__fact { margin: 0; }

  .trat-destacado__fact dt {
    margin-bottom: 0.35rem;
    color: var(--td-muted);
    font: var(--subheading-font-style) var(--subheading-font-weight) 0.66rem / 1.2 var(--subheading-font-family);
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .trat-destacado__fact dd {
    margin: 0;
    color: rgb(var(--text-color));
    font: var(--heading-font-style) var(--heading-font-weight) 1.5rem / 1.1 var(--heading-font-family);
  }

  .trat-destacado__cta { margin-top: 2.5rem; }

  @media screen and (max-width: 520px) {
    .trat-destacado__features { grid-template-columns: minmax(0, 1fr); gap: 1.1rem; }
  }

  @media screen and (min-width: 1000px) {
    .trat-destacado__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      min-height: min(100vh, 920px);
    }

    .trat-destacado__media {
      aspect-ratio: auto;
      min-height: 100%;
    }

    .trat-destacado--media-right .trat-destacado__media { order: 2; }

    .trat-destacado__content {
      padding: clamp(4rem, 7vw, 7rem) clamp(3rem, 6vw, 7rem);
    }
  }
</style>

{% schema %}
{
  "name": "Tratamiento destacado",
  "tag": "div",
  "class": "shopify-section--tratamiento-destacado",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-4" },
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "video", "id": "video", "label": "Vídeo", "info": "Si se añade, sustituye a la imagen." },
    {
      "type": "select",
      "id": "media_position",
      "label": "Posición de la imagen (escritorio)",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "left"
    },
    { "type": "text", "id": "badge", "label": "Etiqueta sobre la imagen" },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Tratamiento destacado" },
    { "type": "inline_richtext", "id": "title", "label": "Título", "default": "Nombre del tratamiento" },
    { "type": "text", "id": "tagline", "label": "Subtítulo en cursiva" },
    { "type": "richtext", "id": "text", "label": "Texto" },
    { "type": "header", "content": "Datos clave" },
    { "type": "text", "id": "fact_1_label", "label": "Dato 1 · etiqueta" },
    { "type": "text", "id": "fact_1_value", "label": "Dato 1 · valor" },
    { "type": "text", "id": "fact_2_label", "label": "Dato 2 · etiqueta" },
    { "type": "text", "id": "fact_2_value", "label": "Dato 2 · valor" },
    { "type": "text", "id": "fact_3_label", "label": "Dato 3 · etiqueta" },
    { "type": "text", "id": "fact_3_value", "label": "Dato 3 · valor" },
    { "type": "header", "content": "Botón" },
    { "type": "text", "id": "button_text", "label": "Texto del botón" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" },
    {
      "type": "select",
      "id": "button_style",
      "label": "Estilo del botón",
      "options": [
        { "value": "solid", "label": "Relleno" },
        { "value": "outline", "label": "Contorno" },
        { "value": "link", "label": "Enlace" }
      ],
      "default": "outline"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Beneficio",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Beneficio" },
        { "type": "textarea", "id": "text", "label": "Texto" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Tratamiento destacado",
      "blocks": [{ "type": "feature" }, { "type": "feature" }, { "type": "feature" }, { "type": "feature" }]
    }
  ]
}
{% endschema %}
