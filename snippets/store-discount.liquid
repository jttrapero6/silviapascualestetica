{%- doc -%}
  Devuelve (como texto) el descuento configurado en Ajustes del tema → Tarjeta de producto →
  "Descuentos de la sección Descuentos" que aplica a un producto:
  · un número (p. ej. "20") si el producto está en una de esas colecciones y tiene porcentaje
  · "sale" si está en la colección pero sin porcentaje
  · vacío si no aplica

  Uso: {% capture pct %}{% render 'store-discount', product: product %}{% endcapture %}

  @param {object} product
{%- enddoc -%}
{%- liquid
  assign store_discount_done = false
  for i in (1..3)
    if store_discount_done
      break
    endif

    assign collection_key = 'store_discount_' | append: i | append: '_collection'
    assign percentage_key = 'store_discount_' | append: i | append: '_percentage'
    assign discount_collection = settings[collection_key]

    if discount_collection != blank
      for product_collection in product.collections
        if product_collection.id == discount_collection.id
          assign percentage = settings[percentage_key]
          if percentage != blank and percentage > 0 and percentage < 100
            echo percentage
          else
            echo 'sale'
          endif
          assign store_discount_done = true
          break
        endif
      endfor
    endif
  endfor
-%}
