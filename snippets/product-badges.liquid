{%- doc -%}
This component is used in product listing and product page to render the badges of a given product

@param {object} product - the product to render the badges
@param {object} [variant] - the specific variant to show the badge from
@param {string} [context] - can be "product" or "card"
@param {string} [direction] - can be "column" or "row". If none is passed, it defaults to "row"
@param {string} [alignment] - can be "start", "center" or "end" (default to start)
@param {boolean} [vertical_text] - if true, badges text are shown vertically
@param {boolean} [show_custom_badge] - if set to true, the custom badge from metafield is shown
@param {boolean} [show_sold_out_badge] - if set to true, the sold out badge is shown
@param {boolean} [show_discount_badge] - if set to true, the discount badge is shown
@param {string} [class] - an extra list of classes being applied to the badge list container
@param {string} [form_id] - an optional form ID to associate with the sold out badge (used to hide/show badge when variant changes)
{%- enddoc -%}

{%- assign variant = variant | default: product.selected_or_first_available_variant -%}

{%- capture badges -%}
  {%- if show_custom_badge -%}
    {%- for custom_badge in product.metafields.custom.badges.value -%}
      <span class="badge badge--custom badge--{{ custom_badge | handle }} {% if vertical_text %}vertical-text{% endif %}">{{ custom_badge }}</span>
    {%- endfor -%}

    {%- comment -%}Etiquetas personalizadas solo para el grid de productos (tarjetas){%- endcomment -%}
    {%- comment -%}
      Cada etiqueta puede tener fecha de inicio y/o fin (metacampos *_fecha_inicio / *_fecha_fin, tipo fecha y hora).
      - Si la fecha de fin ya ha pasado al renderizar, no se pinta.
      - Si tiene fechas, se pinta como <scheduled-badge> y el JS (silviapascualestetica.js) la muestra/oculta
        en tiempo real según la hora del visitante (necesario porque Shopify cachea el HTML).
    {%- endcomment -%}
    {%- if context == 'card' -%}
      {%- assign now_ts = 'now' | date: '%s' | plus: 0 -%}

      {%- for i in (1..2) -%}
        {%- assign label_key = 'etiqueta_' | append: i | append: '_grid_productos' -%}
        {%- assign start_key = label_key | append: '_fecha_inicio' -%}
        {%- assign end_key = label_key | append: '_fecha_fin' -%}

        {%- assign grid_label = product.metafields.custom[label_key].value | strip -%}
        {%- if grid_label == blank -%}{%- continue -%}{%- endif -%}

        {%- assign start_value = product.metafields.custom[start_key].value -%}
        {%- assign end_value = product.metafields.custom[end_key].value -%}
        {%- assign start_ts = '' -%}
        {%- assign end_ts = '' -%}

        {%- if start_value != blank -%}
          {%- assign start_ts = start_value | date: '%s' | plus: 0 -%}
        {%- endif -%}

        {%- if end_value != blank -%}
          {%- assign end_ts = end_value | date: '%s' | plus: 0 -%}
          {%- if end_ts <= now_ts -%}{%- continue -%}{%- endif -%}
        {%- endif -%}

        {%- capture badge_class -%}badge badge--custom badge--grid-label badge--grid-label-{{ i }} badge--{{ grid_label | handle }} {% if vertical_text %}vertical-text{% endif %}{%- endcapture -%}

        {%- if start_ts != '' or end_ts != '' -%}
          <scheduled-badge class="{{ badge_class }}" {% if start_ts != '' %}data-start="{{ start_ts }}"{% endif %} {% if end_ts != '' %}data-end="{{ end_ts }}"{% endif %} {% if start_ts != '' and start_ts > now_ts %}hidden{% endif %}>
            {{- grid_label | escape -}}
          </scheduled-badge>
        {%- else -%}
          <span class="{{ badge_class }}">{{ grid_label | escape }}</span>
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endif -%}

  {%- if show_sold_out_badge and variant.available == false -%}
    <sold-out-badge {% if variant.available %}hidden{% endif %} {% if form_id != blank %}form="{{ form_id }}"{% endif %} class="badge badge--sold-out {% if vertical_text %}vertical-text{% endif %}">
      {{- 'product.general.sold_out_badge' | t -}}
    </sold-out-badge>
  {%- endif -%}

  {%- if show_discount_badge -%}
    {%- liquid
      assign show_on_sale_badge = false

      if context == 'product'
        if variant.compare_at_price > variant.price
          assign show_on_sale_badge = true
        endif
      elsif context == 'card'
        if product.compare_at_price > product.price
          assign show_on_sale_badge = true
        endif
      endif
    -%}

    {%- comment -%}
      Descuentos automáticos de Shopify: la etiqueta se renderiza oculta y assets/silviapascualestetica.js
      la rellena y la muestra si Shopify aplica un descuento a esta variante.
    {%- endcomment -%}
    {%- liquid
      assign discount_lookup_variant = variant
      unless discount_lookup_variant.available
        assign discount_lookup_variant = product.selected_or_first_available_variant
      endunless

      if show_on_sale_badge
        if settings.product_card_discount_mode == 'percentage'
          assign savings = variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round | append: '%'
        else
          capture savings
            echo variant.compare_at_price | minus: variant.price | money
          endcapture
        endif
      endif

      if context == 'card' and product.price_varies and settings.product_card_discount_mode != 'percentage'
        assign auto_discount_template = 'product.general.on_sale_badge' | t
      else
        assign auto_discount_template = 'product.general.discount_badge_html' | t: savings: '__SAVINGS__'
      endif
    -%}

    {%- if show_on_sale_badge or discount_lookup_variant.available -%}
      <on-sale-badge
        class="badge badge--on-sale {% if vertical_text %}vertical-text{% endif %}"
        {% unless show_on_sale_badge %}hidden{% endunless %}
        {%- if discount_lookup_variant.available %}
          data-auto-discount-variant="{{ discount_lookup_variant.id }}"
          data-price="{{ variant.price }}"
          data-compare-at="{{ variant.compare_at_price | default: 0 }}"
          data-money-format="{{ shop.money_format | escape }}"
          data-discount-mode="{{ settings.product_card_discount_mode }}"
          data-badge-template="{{ auto_discount_template | escape }}"
        {%- endif -%}
      >
        {%- if show_on_sale_badge -%}
          {%- liquid
            if context == 'product'
              echo 'product.general.discount_badge_html' | t: savings: savings
            elsif context == 'card'
              if product.compare_at_price_varies or variant.compare_at_price == blank
                echo 'product.general.on_sale_badge' | t
              else
                echo 'product.general.discount_badge_html' | t: savings: savings
              endif
            endif
          -%}
        {%- endif -%}
      </on-sale-badge>
    {%- endif -%}
  {%- endif -%}
{%- endcapture -%}

{%- if badges != blank -%}
  <badge-list class="badge-list {% unless vertical_text %}badge-list--{{ direction | default: 'row' }}{% endunless %} {% if alignment %}{% if direction == 'column' %}align-{{ alignment }}{% else %}justify-{{ alignment }}{% endif %}{% endif %} {{ class }}">
    {{- badges -}}
  </badge-list>
{%- endif -%}